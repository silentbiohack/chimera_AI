# ---- CHIMERA environment ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---- Auth ----
JWT_SECRET=change-me-please-32-bytes-min
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ---- Postgres ----
POSTGRES_USER=chimera
POSTGRES_PASSWORD=chimera
POSTGRES_DB=chimera
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- LLM router ----
# At least one of these must be set for live mode. Without keys, CHIMERA
# falls back to a deterministic synthetic-LLM driver so demos still run.
GEMINI_API_KEY=
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_FLASH_MODEL=gemini-1.5-flash
LLM_MODE=synthetic   # synthetic | gemini

# ---- Arena tuning ----
ARENA_MAX_PARALLEL_ATTACKS=8
ARENA_MUTATION_BUDGET=64
ARENA_TICK_MS=750

# ---- CORS / Bus ----
CORS_ORIGINS=http://localhost:3000
BUS_MODE=auto              # auto | redis | local

# ---- Arena dispatch ----
# When unset (default) arena sessions run in-process via FastAPI's
# BackgroundTasks — no external worker needed. Set to "true" to enqueue
# into Redis and consume from a separate `python -m app.workers.runner`
# fleet (recommended for multi-tenant scale + isolation).
USE_WORKER_QUEUE=false

# ---- Frontend ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000
